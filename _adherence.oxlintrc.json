{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/shift/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|DM Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, DM Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|shape|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, shape, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|accent|ink|reliable|hazard|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'accent' | 'ink' | 'reliable' | 'hazard' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|pill)$/]",
        "message": "<Badge> shape must be one of 'square' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|leadingIcon|trailingIcon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, leadingIcon, trailingIcon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|ink|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'ink' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:paper|flat|stamp|ink|brand|accent)$/]",
        "message": "<Card> variant must be one of 'paper' | 'flat' | 'stamp' | 'ink' | 'brand' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FiableStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|rotate|size|key|ref|className|style|children)$/]",
        "message": "<FiableStamp> doesn't accept that prop. Declared props: children, rotate, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='FiableStamp'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<FiableStamp> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HazardDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|variant|key|ref|className|style|children)$/]",
        "message": "<HazardDivider> doesn't accept that prop. Declared props: height, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='HazardDivider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:orange|yellow)$/]",
        "message": "<HazardDivider> variant must be one of 'orange' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|size|leadingIcon|trailingSlot|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, size, leadingIcon, trailingSlot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReliabilityScore'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|shifts|size|showLabel|key|ref|className|style|children)$/]",
        "message": "<ReliabilityScore> doesn't accept that prop. Declared props: score, shifts, size, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReliabilityScore'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ReliabilityScore> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectorChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:sector|lang|key|ref|className|style|children)$/]",
        "message": "<SectorChip> doesn't accept that prop. Declared props: sector, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectorChip'] > JSXAttribute[name.name='sector'] > Literal[value!=/^(?:paysagement|agriculture|demenagement|ski|deneigement|construction)$/]",
        "message": "<SectorChip> sector must be one of 'paysagement' | 'agriculture' | 'demenagement' | 'ski' | 'deneigement' | 'construction'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectorChip'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:fr|en)$/]",
        "message": "<SectorChip> lang must be one of 'fr' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|sublabel|tone|align|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, sublabel, tone, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|brand|accent|reliable)$/]",
        "message": "<Stat> tone must be one of 'ink' | 'brand' | 'accent' | 'reliable'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Stat> align must be one of 'left' | 'center'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
